# Secrets (docs/git-rules.md §12.5)
.env
.env.*
!.env.example
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.pem
*.key
*.p12
*.pfx
*.cer
*.mobileprovision
*.provisionprofile

# Go build output
bin/
dist/
build/bin/

# Installers
*.dmg
*.exe
*.msi
*.AppImage
*.deb
*.rpm

# Frontend
node_modules/
web/dist/
coverage/
